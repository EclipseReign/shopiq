# SQLite is used locally. Relative paths are resolved from the repository root.
SHOPIQ_DB_PATH=backend/data/shopiq.sqlite
# Set DATABASE_URL to use PostgreSQL instead.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shopiq
# PGSSLMODE=require
# PG_POOL_MAX=5
PORT=3000
API_PORT=5000
BACKEND_URL=http://127.0.0.1:5000
PYTHON_BIN=python
SCRAPER_TIMEOUT_MINUTES=30
# CHROME_BINARY=C:/Program Files/Google/Chrome/Application/chrome.exe
# Required for remote scraper control. Loopback requests work locally.
# SCRAPER_TOKEN=replace-with-a-long-random-value
