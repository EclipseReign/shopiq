{
  "name": "shopiq",
  "version": "3.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "cloud"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run build --workspace frontend",
    "start": "node scripts/dev.js --production",
    "db:init": "python backend/scraper/storage.py",
    "scrape": "node backend/scraper/http-scraper.mjs",
    "test": "python -m unittest discover -s backend/tests -p test_*.py && node --test backend/tests/*.test.js",
    "deploy": "npm run build && npm run deploy --workspace cloud"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16"
  }
}
